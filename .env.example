# 复制为 .env 后按需修改；.env 不要提交到 Git
# MySQL root 密码（容器内使用）
MYSQL_ROOT_PASSWORD=inkspace123

# JWT 密钥：必须 >= 32 字节随机串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=please-change-me-to-a-random-32-bytes-string

# AI：mock=true 时不调用真实模型，无需 API Key
AI_MOCK=true
AI_API_KEY=
AI_MODEL=deepseek-chat

# 分享链接前缀（部署后改成真实域名，例如 https://notes.example.com/share/）
SHARE_BASE_URL=http://localhost/share/

# Nginx 对外端口
HTTP_PORT=80

# 浏览器跨域白名单（逗号分隔）。必须包含你实际访问前端的地址（含端口），
# 否则注册/登录等请求会因 Origin 不在白名单被后端 403 拒绝。
ALLOWED_ORIGINS=http://localhost,http://localhost:8088,http://localhost:3000
